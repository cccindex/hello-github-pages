generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTION_STARTED
  CONNECTED
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum ApprovalMode {
  ALWAYS_APPROVE
  AUTONOMOUS
}

enum AutomationStatus {
  SETUP_REQUIRED
  TEST_REQUIRED
  READY
  ACTIVE
  PAUSED
  EXPIRED
  BLOCKED
}

enum ExecutionType {
  TEST_PURCHASE
  MANUAL_PURCHASE
  SCHEDULED_PURCHASE
}

enum ExecutionStatus {
  QUEUED
  EVALUATING_POLICY
  BLOCKED_BY_POLICY
  SKIPPED_PREVIOUS_EXECUTION_PENDING
  PENDING_USER_APPROVAL
  PENDING_SIGNATURE
  PENDING_CONFIRMATION
  PENDING_SETTLEMENT
  SUCCESS
  DENIED
  FAILED
  UNKNOWN
}

model User {
  id               String            @id @default(cuid())
  localUserId      String            @unique
  privyUserId      String?           @unique
  email            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payboxConnection PayboxConnection?
  automation       Automation?
  executions       Execution[]
}

model PayboxConnection {
  id                    String           @id @default(cuid())
  userId                String           @unique
  status                ConnectionStatus @default(NOT_CONNECTED)
  externalUserId        String?
  selectedCredentialId  String?
  selectedWalletAddress String?
  selectedWalletName    String?
  selectedWalletChains  String[]
  approvalMode          ApprovalMode?
  usdcBalanceAtomic     BigInt           @default(20000000)
  cbbtcBalanceAtomic    BigInt           @default(0)
  solBalanceLamports    BigInt           @default(50000000)
  connectedAt           DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Automation {
  id                   String           @id @default(cuid())
  userId               String           @unique
  status               AutomationStatus @default(SETUP_REQUIRED)
  cronExpression       String           @default("*/5 * * * *")
  timezone             String           @default("UTC")
  amountAtomic         String           @default("1000000")
  sourceMint           String
  destinationMint      String
  chain                String           @default("solana:mainnet")
  maxPerExecutionCents Int              @default(100)
  maxExecutionsPerHour Int              @default(12)
  dailyLimitCents      Int              @default(1200)
  lifetimeLimitCents   Int              @default(2500)
  activatedAt          DateTime?
  expiresAt            DateTime?
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions           Execution[]
}

model Execution {
  id                    String          @id @default(cuid())
  userId                String
  automationId          String
  type                  ExecutionType
  idempotencyKey        String          @unique
  scheduledFor          DateTime?
  providerRequestId     String?         @unique
  status                ExecutionStatus
  amountAtomic          String          @default("1000000")
  displayAmountCents    Int             @default(100)
  receivedCbbtcAtomic   BigInt?
  isSpendReserved       Boolean         @default(false)
  policyDecisionJson    Json
  providerResponseJson  Json?
  transactionSignature String?
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  completedAt           DateTime?
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation            Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  transitions           ExecutionTransition[]

  @@index([automationId, createdAt])
  @@index([status])
}

model ExecutionTransition {
  id          String          @id @default(cuid())
  executionId String
  fromStatus  ExecutionStatus?
  toStatus    ExecutionStatus
  note        String?
  createdAt   DateTime        @default(now())
  execution   Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}
